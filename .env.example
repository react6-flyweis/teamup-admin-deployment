# ==============================================================================
# TeamUp Admin - Environment Variables Example
# Copy this file to `.env` (or `.env.local`) and configure your values.
# Vite requires variables exposed to the client to be prefixed with `VITE_`.
# ==============================================================================

# Backend API base URL
# Used by the Axios HTTP client (src/utils/apiClient.ts) and media preview resolvers.
# Local Development: http://localhost:5000/api
# Production: https://api.teamuparena.com/api
VITE_API_URL=https://api.teamuparena.com/api

# File Upload Limits (in Megabytes)
# Configured in src/constants/upload.ts with sensible fallback defaults if unset.
# Maximum video upload size in MB (default: 50)
VITE_MAX_VIDEO_SIZE_MB=50

# Maximum image upload size in MB (default: 5)
VITE_MAX_IMAGE_SIZE_MB=5

# Maximum general file upload size in MB (default: 10)
VITE_MAX_FILE_SIZE_MB=10
